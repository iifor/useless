{
  "name": "uno-pangyu-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "dev:windows": "node scripts/dev-windows.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "dmg": "tauri build --bundles dmg --no-sign",
    "exe": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --no-sign",
    "build:windows": "node scripts/build-windows.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
